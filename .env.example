# Copy this file to .env and fill in the real values.
# .env is gitignored — the token must never be committed.

# Long-lived Page access token for the SoCal Bobcat Facebook page.
FB_PAGE_TOKEN=paste-the-long-lived-page-token-here

# The numeric Page ID. Run scripts/post-to-facebook.ps1 -WhoAmI to look it up.
FB_PAGE_ID=61592298635738
